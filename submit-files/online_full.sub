# HTCondor submit file for DeepConf full-dataset online mode (multiple runs)
# Usage: condor_submit /nethome/rhakim/projects/deepconfTesting/submit-files/online_full.sub
#
# Each queued job processes ALL questions with a different RUN_ID=$(Process).
# The model is loaded once per job; questions are looped internally.
#
# Environment variables:
#   MODEL_PATH              (required) path to HuggingFace model
#   DATASET_PATH            (required) path to JSONL dataset file
#   RUN_ID                  set automatically to $(Process)
#   WARMUP_TRACES           number of warmup traces (default: 16)
#   TOTAL_BUDGET            max total traces per question (default: 256)
#   CONFIDENCE_PERCENTILE   percentile threshold for early exit (default: 10)
#   MAX_TOKENS              max generation tokens (default: 64000)
#   OUTPUT_DIR              where to write .pkl output
#   TENSOR_PARALLEL         tensor parallel size (default: 1)
#   MODEL_TYPE              prompt formatting: deepseek, gpt (default: deepseek)
#   TEMPERATURE             sampling temperature (default: 0.6)
#   TOP_P                   nucleus sampling top-p (default: 0.95)
#   TOP_K                   top-k sampling (default: 0)
#   WINDOW_SIZE             sliding window size for confidence (default: 2048)
#   QID_START               first question index, inclusive (default: all)
#   QID_END                 last question index, exclusive (default: all)
#   NO_MULTIPLE_VOTING      set to any value to disable multiple voting

universe                = vanilla
environment             = "RUN_ID=$(Process) TENSOR_PARALLEL=1 MAX_TOKENS=32000 WARMUP_TRACES=16 TOTAL_BUDGET=32 CONFIDENCE_PERCENTILE=10 WINDOW_SIZE=2048 TOP_P=0.95 TEMPERATURE=0.7 MODEL_PATH=/data/users/zakhalili/models/models--Qwen--Qwen3-8B/snapshots/b968826d9c46dd6066d109eabc6255188de91218 DATASET_PATH=/nethome/rhakim/projects/deepconfTesting/data/MATH500/MATH500.jsonl OUTPUT_DIR=/data/users/rhakim/logs/deepconfTesting/qwen_8b_MATH500"
initialdir              = /nethome/rhakim
executable              = /nethome/rhakim/projects/deepconfTesting/scripts/online_full_run.sh
output                  = /data/users/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).out
error                   = /data/users/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).err
log                     = /data/users/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).log
request_CPUs            = 1
request_memory          = 30G
request_GPUs            = 1
requirements = (machine == "cl18lx.lsv.uni-saarland.de" || machine == "cl17lx.lsv.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 32000)
queue 5
