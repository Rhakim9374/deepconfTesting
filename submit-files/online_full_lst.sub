# HTCondor submit file for DeepConf-online on the LST cluster (DeepSeek).
#
# The DeepConf-online baseline for the thesis benchmark table: one dataset,
# K runs, the three ExploreExploitThink voting read-outs recorded alongside
# DeepConf's own (deepconfTesting/eet_voting.py). Sampling, max_tokens,
# window and prompt match the ExploreExploitThink DeepSeek runs exactly, so
# accuracy, decoded tokens and wall-clock are comparable line by line.
#
# Usage (from /nethome/rhakim, after `git pull` on the submit node):
#   condor_submit -a 'WARMUP = 2' -a 'BUDGET = 4'  -a 'DATASET = AIME26' \
#       projects/deepconfTesting/submit-files/online_full_lst.sub
# The budget points are (WARMUP, BUDGET) = (2, 4), (4, 8), (8, 16), (16, 32),
# (16, 64): DeepConf's own 16 warm-up traces wherever the budget exceeds
# them, half the budget below 32. The paper runs each point once, for its
# time; its accuracy and tokens replay the same rule on ExploreExploitThink's
# full-parallel pool.
#
# The dataset is read from the ExploreExploitThink checkout on purpose:
# deepconfTesting/data/ is gitignored, and pointing both methods at the
# one tracked file guarantees they grade the byte-identical problem set.
#
# Macros:
#   WARMUP     warmup traces (the pool the conf_bar percentile is taken over)
#   BUDGET     total traces per question; BUDGET - WARMUP are gated
#   DATASET    names the jsonl and the output subdir
#   DTYPE      dataset_type: math, or mcqa for gpqa_diamond (metadata only —
#              both answer instructions are the same \boxed{} suffix)
#   PERCENTILE confidence_percentile; 10 = DeepConf-low (paper headline)
#   QSTART/QEND question index range, [start, end); the defaults span any
#              dataset. Set QEND for a smoke run, e.g. -a 'QEND = 2'
#   K          number of independent runs. The rid is run_<ClusterId>_<Process>
#              (the ExploreExploitThink convention), so resubmitting the
#              same command later adds a new run to the same output dir
#              and can never collide with or overwrite an earlier one.
#
# HTCondor holds the job if it cannot create the output/error/log files, so
# the logfile directory must exist BEFORE the first condor_submit:
#   mkdir -p /scratch/rhakim/logs/deepconfTesting/logfiles
# (OUTPUT_DIR does not need this -- main.py makedirs it.)
#
# MODEL_PATH must point at the linked DeepSeek directory on LST (see the
# comment above MODEL_PATH). VERIFY IT EXISTS BEFORE SUBMITTING:
#   ls -l /scratch/rhakim/models/DeepSeek-R1-0528-Qwen3-8B

universe                = vanilla
TENSOR_PARALLEL         = 1
WARMUP                  = 8
BUDGET                  = 16
DATASET                 = AIME26
DTYPE                   = math
PERCENTILE              = 10
QSTART                  = 0
QEND                    = 999999
K                       = 1
# vLLM 0.28 venv of the paper's runs (scripts/setup_vllm_env.sh in
# ExploreExploitThink); the thesis runs used
# /nethome/rhakim/envs/gemma4Env
CONDA_ENV               = /nethome/rhakim/envs/vllm028Env
# DeepSeek snapshot 6e8885a6 (/scratch/common_models) with tokenizer_class
# TokenizersBackend (scripts/fix_tokenizer_class.sh in
# ExploreExploitThink); the snapshot as is loads a tokenizer that strips
# the prompt's spaces
MODEL_PATH              = /scratch/rhakim/models/DeepSeek-R1-0528-Qwen3-8B
MODEL_TYPE              = deepseek
TEMPERATURE             = 0.7
TOP_P                   = 0.95
TOP_K                   = 20
MAX_TOKENS              = 64000
TAG                     = DS
# _V028: runs on the vLLM 0.28 venv never pool with the thesis's *_T07 dirs
TSUF                    = T07_V028
environment             = "RUN_ID=run_$(ClusterId)_$(Process) CONDOR_PROCESS=$(Process) CONDA_ENV=$(CONDA_ENV) VLLM_USE_FLASHINFER_SAMPLER=0 VLLM_USE_DEEP_GEMM=0 VLLM_USE_V2_MODEL_RUNNER=0 TENSOR_PARALLEL=$(TENSOR_PARALLEL) WARMUP_TRACES=$(WARMUP) TOTAL_BUDGET=$(BUDGET) CONFIDENCE_PERCENTILE=$(PERCENTILE) WINDOW_SIZE=2048 MAX_TOKENS=$(MAX_TOKENS) MODEL_TYPE=$(MODEL_TYPE) DATASET_TYPE=$(DTYPE) TEMPERATURE=$(TEMPERATURE) TOP_P=$(TOP_P) TOP_K=$(TOP_K) QID_START=$(QSTART) QID_END=$(QEND) MODEL_PATH=$(MODEL_PATH) DATASET_PATH=/nethome/rhakim/projects/ExploreExploitThink/data/$(DATASET).jsonl OUTPUT_DIR=/scratch/rhakim/logs/deepconfTesting/$(TAG)_DEEPCONF_W$(WARMUP)_B$(BUDGET)_P$(PERCENTILE)_$(TSUF)/$(DATASET)"
initialdir              = /nethome/rhakim
executable              = /nethome/rhakim/projects/deepconfTesting/scripts/online_full_run.sh
output                  = /scratch/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).out
error                   = /scratch/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).err
log                     = /scratch/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).log
request_CPUs            = 1
request_memory          = 64G
request_GPUs            = $(TENSOR_PARALLEL)
requirements            = regexp("H100", GPUs_DeviceName)
+MaxWallTime            = 604800
queue $(K)
