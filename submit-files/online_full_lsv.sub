# HTCondor submit file for DeepConf-online on the LSV cluster (DeepSeek).
#
# The LSV twin of online_full_lst.sub: same arms, same sampling,
# max_tokens, window and prompt as the ExploreExploitThink DeepSeek runs
# (submit-files/eet_sc.sub, eet_v4.sub), so accuracy, decoded tokens and
# wall-clock are comparable line by line; the three eet read-outs are
# recorded alongside DeepConf's own (deepconfTesting/eet_voting.py).
# Both runners use gemma4Env (vLLM 0.23) on LSV since 2026-09-11: deepConfEnv's
# vLLM 0.10.2 corrupts preempted sequences under prefix caching.
#
# Usage (from /nethome/rhakim, after `git pull` on the submit node):
#   condor_submit -a 'WARMUP = 2' -a 'BUDGET = 4' -a 'DATASET = gpqa_diamond' \
#       projects/deepconfTesting/submit-files/online_full_lsv.sub
# The three budget points are (WARMUP, BUDGET) = (2, 4), (4, 8), (8, 16).
#
# The dataset is read from the ExploreExploitThink checkout on purpose:
# deepconfTesting/data/ is gitignored, and pointing both methods at the
# one tracked file guarantees they grade the byte-identical problem set.
#
# Macros:
#   WARMUP     warmup traces (the pool the conf_bar percentile is taken over)
#   BUDGET     total traces per question; BUDGET - WARMUP are gated
#   DATASET    names the jsonl and the output subdir
#   DTYPE      dataset_type: math, or mcqa for gpqa_diamond (metadata only —
#              both answer instructions are the same \boxed{} suffix)
#   PERCENTILE confidence_percentile; 10 = DeepConf-low (paper headline)
#   QSTART/QEND question index range, [start, end); the defaults span any
#              dataset. Set QEND for a smoke run, e.g. -a 'QEND = 2'
#   K          number of independent runs. The rid is run_<ClusterId>_<Process>
#              (the ExploreExploitThink convention), so resubmitting the
#              same command later adds a new run to the same output dir
#              and can never collide with or overwrite an earlier one.
#
# The logfile directory must exist BEFORE the first condor_submit:
#   mkdir -p /data/users/rhakim/logs/deepconfTesting/logfiles

universe                = vanilla
WARMUP                  = 8
BUDGET                  = 16
DATASET                 = gpqa_diamond
DTYPE                   = mcqa
PERCENTILE              = 10
QSTART                  = 0
QEND                    = 999999
K                       = 1
MODEL_PATH              = /data/users/zakhalili/models/models--deepseek-ai--DeepSeek-R1-0528-Qwen3-8B/snapshots/6e8885a6ff5c1dc5201574c8fd700323f23c25fa
environment             = "RUN_ID=run_$(ClusterId)_$(Process) CONDOR_PROCESS=$(Process) CONDA_ENV=/data/users/rhakim/conda/envs/gemma4Env VLLM_USE_FLASHINFER_SAMPLER=0 TENSOR_PARALLEL=1 WARMUP_TRACES=$(WARMUP) TOTAL_BUDGET=$(BUDGET) CONFIDENCE_PERCENTILE=$(PERCENTILE) WINDOW_SIZE=2048 MAX_TOKENS=64000 MODEL_TYPE=deepseek DATASET_TYPE=$(DTYPE) TEMPERATURE=0.7 TOP_P=0.95 TOP_K=20 QID_START=$(QSTART) QID_END=$(QEND) MODEL_PATH=$(MODEL_PATH) DATASET_PATH=/nethome/rhakim/projects/ExploreExploitThink/data/$(DATASET).jsonl OUTPUT_DIR=/data/users/rhakim/logs/deepconfTesting/DS_DEEPCONF_W$(WARMUP)_B$(BUDGET)_P$(PERCENTILE)_T07/$(DATASET)"
initialdir              = /nethome/rhakim
executable              = /nethome/rhakim/projects/deepconfTesting/scripts/online_full_run.sh
output                  = /data/users/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).out
error                   = /data/users/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).err
log                     = /data/users/rhakim/logs/deepconfTesting/logfiles/online_full.$(ClusterId).$(Process).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).log
request_CPUs            = 1
request_memory          = 30G
request_GPUs            = 1
requirements            = (machine == "cl18lx.lsv.uni-saarland.de" || machine == "cl17lx.lsv.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
queue $(K)
