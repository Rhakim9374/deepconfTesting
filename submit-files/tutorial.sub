# HTCondor submit file for DeepConf
# Usage: condor_submit /nethome/rhakim/projects/deepconfTesting/submit-files/tutorial.sub
#
# Environment variables:
#   MODEL_PATH       (required) path to HuggingFace model
#   BUDGET           number of traces (default: 4)
#   QUESTION_INDEX   which question from dataset (default: 0)
#   DATASET_PATH     path to JSONL dataset file
#   MAX_TOKENS       max generation tokens
#   OUTPUT_DIR       where to write .pkl output
#   TENSOR_PARALLEL  tensor parallel size (default: 1)
#   MODEL_TYPE       model type for tokenizer (default: gpt)
#   TEMPERATURE      sampling temperature (default: 1.0)
#   WINDOW_SIZE      window size (default: 2048)
#   RUN_ID           run identifier for output naming
#   REASONING_EFFORT reasoning effort level (e.g. low, medium, high)
#   TOP_P            nucleus sampling top-p (default: 1.0)
#   TOP_K            top-k sampling (default: -1, disabled)
#   NO_MULTIPLE_VOTING  set to any value to disable multiple voting

universe                = vanilla
environment             = "TENSOR_PARALLEL=1 MAX_TOKENS=4096 BUDGET=8 WINDOW_SIZE=256 TOP_P=0.7 TOP_K=-1 QUESTION_INDEX=0 MODEL_PATH=/data/users/zakhalili/models/models--Qwen--Qwen3-8B/snapshots/b968826d9c46dd6066d109eabc6255188de91218 DATASET_PATH=/nethome/rhakim/projects/deepconfTesting/data/AIME24.jsonl OUTPUT_DIR=/data/users/rhakim/logs/deepconfTesting/outputs"
initialdir              = /nethome/rhakim
executable              = /nethome/rhakim/projects/deepconfTesting/scripts/run.sh
output                  = /data/users/rhakim/logs/deepconfTesting/logfiles/run.sh.$(ClusterId).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).out
error                   = /data/users/rhakim/logs/deepconfTesting/logfiles/run.sh.$(ClusterId).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).err
log                     = /data/users/rhakim/logs/deepconfTesting/logfiles/run.sh.$(ClusterId).$(Year)_$(Month)_$(Day)_$(SUBMIT_TIME).log
request_CPUs            = 1
request_memory          = 20G
request_GPUs            = 1
#requirements            = (GPUs_GlobalMemoryMb >= 16000)
requirements		= (machine == "cl18lx.lsv.uni-saarland.de")
# && (machine == "cl17lx.lsv.uni-saarland.de")
queue 1
